---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Structured intelligence on what is actually happening in AI.' } = Astro.props;
const meta = await import('../data/meta.json');

const stamp = new Date(meta.default.generated_at)
  .toISOString().replace('T', ' ').slice(0, 16);

const corpus = (meta.default as { corpus_documents?: number }).corpus_documents ?? 0;
const corpusLabel = corpus >= 1000
  ? `${Math.round(corpus / 1000)}K`
  : String(corpus);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to signals</a>

    <header class="bar">
      <div class="shell bar-inner">
        <a class="mark" href="/">
          <span class="mark-rule" aria-hidden="true"></span>
          <span class="mark-name">SIGNAL<span class="mark-thin">INDEX</span></span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a href="/">Feed</a>
          <a href="/entities">Entities</a>
          <a href="/method">Method</a>
        </nav>

        <div class="telemetry">
          <span class="tel">
            <span class="tel-k">CORPUS</span>
            <span class="tel-v num">{corpusLabel}</span>
          </span>
          <span class="tel">
            <span class="tel-k">SIGNALS</span>
            <span class="tel-v num">{String(meta.default.signal_count).padStart(3, '0')}</span>
          </span>
          <span class="tel">
            <span class="tel-k">LAST PASS</span>
            <span class="tel-v num">{stamp}Z</span>
          </span>
          <span class="live">
            <span class="live-dot" aria-hidden="true"></span>
            <span class="tel-k">LIVE</span>
          </span>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot-inner">
        <p class="foot-claim">
          Every claim links to the source it came from. Nothing is published
          that cannot be traced back to a document we read.
        </p>
        <p class="foot-meta num">
          {corpusLabel} DOCUMENTS · {meta.default.signal_count} SIGNALS ·
          {meta.default.entity_count} ENTITIES · SCHEMA v{meta.default.schema_version} ·
          <a href="/method">METHOD</a>
        </p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ember);
        color: var(--void);
        padding: 0.65rem 1.1rem;
        z-index: 100;
        text-decoration: none;
        font-size: var(--t-xs);
      }
      .skip:focus { left: 0; }

      .bar {
        border-bottom: var(--rule);
        background: var(--void);
        position: sticky;
        top: 0;
        z-index: 20;
        padding-top: env(safe-area-inset-top, 0px);
      }

      .bar-inner {
        display: flex;
        align-items: center;
        gap: var(--gap-5);
        min-height: 3.25rem;
      }

      .mark {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        margin-right: auto;
      }

      /* The mark is the product's thesis in miniature: a confidence rule. */
      .mark-rule {
        width: 3px;
        height: 0.95rem;
        background: linear-gradient(
          to bottom,
          var(--ember) 0 55%,
          var(--amber) 55% 82%,
          var(--grey) 82% 100%
        );
      }

      .mark-name {
        font-family: var(--mono);
        font-size: var(--t-sm);
        font-weight: 600;
        letter-spacing: 0.08em;
      }
      .mark-thin { color: var(--text-faint); font-weight: 400; margin-left: 0.15em; }

      .nav {
        display: flex;
        gap: var(--gap-4);
        font-size: var(--t-xs);
        color: var(--text-dim);
      }
      .nav a {
        text-decoration: none;
        padding: 0.2rem 0;
        border-bottom: 1px solid transparent;
        transition: color 0.12s, border-color 0.12s;
      }
      .nav a:hover { color: var(--ember); border-bottom-color: var(--ember); }

      .telemetry {
        display: flex;
        align-items: center;
        gap: var(--gap-4);
      }

      .tel { display: inline-flex; align-items: baseline; gap: 0.4rem; }

      .tel-k {
        font-family: var(--mono);
        font-size: var(--t-2xs);
        letter-spacing: 0.1em;
        color: var(--text-faint);
      }
      .tel-v { font-size: var(--t-2xs); color: var(--text-dim); }

      .live { display: inline-flex; align-items: center; gap: 0.4rem; }
      .live .tel-k { color: var(--ember); }

      .live-dot {
        width: 5px; height: 5px;
        background: var(--ember);
        animation: pulse 3s ease-in-out infinite;
      }

      /* The single ambient motion on the site: it signals "this is live". */
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.25; }
      }

      .foot {
        margin-top: var(--gap-7);
        border-top: var(--rule);
        background: var(--void);
        padding-block: var(--gap-5);
        padding-bottom: calc(var(--gap-5) + env(safe-area-inset-bottom, 0px));
      }

      .foot-claim {
        margin: 0 0 var(--gap-3);
        max-width: 54ch;
        color: var(--text-dim);
        font-size: var(--t-sm);
        line-height: 1.6;
      }

      .foot-meta {
        margin: 0;
        font-size: var(--t-2xs);
        letter-spacing: 0.06em;
        color: var(--text-faint);
      }
      .foot-meta a { color: var(--rust); text-decoration: none; }
      .foot-meta a:hover { color: var(--ember); }

      @media (max-width: 860px) {
        .bar-inner { flex-wrap: wrap; gap: var(--gap-3); padding-block: 0.6rem; min-height: 0; }
        .mark { margin-right: 0; flex: 1 1 auto; }
        .telemetry { flex-basis: 100%; order: 3; gap: var(--gap-3); flex-wrap: wrap; }
      }
    </style>
  </body>
</html>
