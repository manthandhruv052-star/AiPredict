---
import Base from '../layouts/Base.astro';
import entitiesData from '../data/entities.json';
import { relativeTime } from '../lib/display.ts';
import type { EntityProfile } from '../../../pipeline/schema.ts';

const entities = entitiesData as EntityProfile[];

const KIND_ORDER = ['org', 'model', 'person', 'repo', 'regulation', 'chip', 'product'];
const KIND_NOUN: Record<string, string> = {
  org: 'Organizations', model: 'Models', person: 'People', product: 'Products',
  chip: 'Hardware', regulation: 'Regulation', repo: 'Repositories',
};

const grouped = KIND_ORDER
  .map((kind) => ({ kind, items: entities.filter((e) => e.kind === kind) }))
  .filter((g) => g.items.length > 0);

const busiest = Math.max(...entities.map((e) => e.signal_count));
---

<Base title="Entities — Signal Index">
  <section class="head">
    <div class="shell">
      <h1>Who and what we track</h1>
      <p class="lede">
        Every organization, model, and person that appears in a signal gets a
        page collecting everything on the record about them.
      </p>
    </div>
  </section>

  <section class="listing">
    <div class="shell">
      {grouped.map((group) => (
        <div class="group">
          <h2 class="group-head">{KIND_NOUN[group.kind]}</h2>
          <ul class="ents">
            {group.items.map((e) => (
              <li class="ent">
                <a class="ent-link" href={`/entity/${e.slug}`}>
                  <span class="ent-name">{e.name}</span>
                  <span class="ent-bar" aria-hidden="true">
                    <span class="ent-fill" style={`width:${(e.signal_count / busiest) * 100}%`}></span>
                  </span>
                  <span class="ent-n">{e.signal_count}</span>
                  <span class="ent-when">{relativeTime(e.last_seen_at)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .head { padding-block: var(--gap-6) var(--gap-5); border-bottom: var(--rule); }
  .head h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, var(--t-2xl));
    letter-spacing: -0.022em;
    line-height: 1.08;
    margin: 0 0 var(--gap-3);
    max-width: 16ch;
  }
  .lede { margin: 0; color: var(--slate-soft); max-width: 52ch; font-size: var(--t-md); }

  .listing { padding-top: var(--gap-5); }
  .group { margin-bottom: var(--gap-6); }

  .group-head {
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--slate-faint);
    margin: 0 0 var(--gap-2);
    padding-bottom: var(--gap-2);
    border-bottom: 1px solid var(--ink);
  }

  .ents { list-style: none; margin: 0; padding: 0; }
  .ent { border-bottom: var(--rule); }

  .ent-link {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr) 2.5rem 5rem;
    align-items: center;
    gap: var(--gap-3);
    padding-block: var(--gap-3);
    text-decoration: none;
    transition: background 0.12s;
  }
  .ent-link:hover { background: var(--paper-sunk); }

  .ent-name { font-size: var(--t-base); }

  /* Volume as a bar: scanning who is busiest is the point of this page. */
  .ent-bar { height: 2px; background: var(--paper-edge); }
  .ent-fill { display: block; height: 100%; background: var(--slate-faint); }

  .ent-n {
    font-family: var(--serif);
    font-size: var(--t-md);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .ent-when { font-size: var(--t-xs); color: var(--slate-faint); text-align: right; }

  @media (max-width: 640px) {
    .ent-link { grid-template-columns: 1fr 2.5rem; gap: var(--gap-2); }
    .ent-bar, .ent-when { display: none; }
  }
</style>
