---
import Base from '../layouts/Base.astro';
import SignalRow from '../components/SignalRow.astro';
import CategoryNav from '../components/CategoryNav.astro';
import feedData from '../data/feed.json';
import metaData from '../data/meta.json';
import {
  groupByDay, bandColor, SIGNAL_TYPE_LABELS, type FeedEntry,
} from '../lib/display.ts';

const feed = feedData as FeedEntry[];

// Debunked and stale signals stay reachable by permalink but leave the default
// feed — showing them beside live intelligence would misrepresent the record.
const live = feed.filter((e) => e.status !== 'debunked' && e.status !== 'stale');
const days = groupByDay(live);

const lead = live[0];

/** The front page shows the most recent slice; categories hold the rest. */
const FRONT_PAGE_LIMIT = 60;
const shown = new Set(live.slice(0, FRONT_PAGE_LIMIT).map((e) => e.id));

const rest = days
  .map((d) => ({
    ...d,
    entries: d.entries.filter((e) => e.id !== lead?.id && shown.has(e.id)),
  }))
  .filter((d) => d.entries.length > 0);

const corpusDocs = (metaData as { corpus_documents?: number }).corpus_documents ?? 0;
const sourceFeeds = (metaData as { source_feeds?: number }).source_feeds ?? 0;
const corroborated = live.filter((e) => e.corroboration_count >= 3).length;
const primarySourced = live.filter((e) => e.top_sources.some((s) => s.tier === 1)).length;
const verified = live.filter((e) => e.confidence_band === 'verified').length;
const mean = Math.round(live.reduce((a, e) => a + e.confidence_score, 0) / live.length);

// Ascending, so the plot reads as a distribution rather than a bar chart.
// Capped: past ~90 ticks the bars fall below 2px and the row overflows the
// viewport. An evenly-spaced sample preserves the distribution's shape.
const PLOT_TICKS = 90;
const sorted = [...live].sort((a, b) => a.confidence_score - b.confidence_score);
const spectrum = sorted.length <= PLOT_TICKS
  ? sorted
  : Array.from({ length: PLOT_TICKS }, (_, i) =>
      sorted[Math.round((i * (sorted.length - 1)) / (PLOT_TICKS - 1))]);

// Only categories with enough volume to be worth scanning.
const typeCounts = live.reduce<Record<string, number>>((acc, e) => {
  acc[e.type] = (acc[e.type] ?? 0) + 1; return acc;
}, {});
const topTypes = Object.entries(typeCounts).sort((a, b) => b[1] - a[1]).slice(0, 7);
const maxType = Math.max(...topTypes.map(([, n]) => n));
// A bar chart where every value is identical is decoration, not data.
const showCatBars = maxType > 1;
---

<Base title="Signal Index — what is actually happening in AI">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-text">
        <p class="prompt num">
          <span class="prompt-sig">signal</span><span class="prompt-c">@</span><span class="prompt-h">index</span>
          <span class="prompt-p">:~$</span> watch --all-sources<span class="cursor"></span>
        </p>
        <h1 class="thesis">
          Fifty outlets report one rumor.<br />
          This shows one signal, and how far to trust it.
        </h1>
        <p class="sub">
          Public sources are ingested continuously, collapsed into deduplicated
          signals, and scored on how well attested each one is.
        </p>
      </div>

      {/* The spectrum is the argument: every live signal plotted by how well
          attested it is. It is the hero because it IS the product. */}
      <figure class="spectrum">
        <figcaption class="spec-head">
          <span class="spec-title caret">CONFIDENCE DISTRIBUTION</span>
          <span class="spec-stat num">MEAN {mean}</span>
        </figcaption>
        <div class="plot">
          {spectrum.map((e) => (
            <a
              class="tick"
              href={`/signal/${e.id}`}
              style={`--h:${e.confidence_score}%;--c:${bandColor(e.confidence_band)}`}
              title={`${e.title} — ${e.confidence_score}`}
            ><span class="sr-only">{e.title}, confidence {e.confidence_score}</span></a>
          ))}
        </div>
        <div class="axis num">
          <span>00 THINLY SOURCED</span>
          <span>CONFIRMED 100</span>
        </div>
      </figure>
    </div>
  </section>

  <section class="metrics">
    <div class="shell metrics-grid">
      <div class="metric">
        <span class="m-v num">{corpusDocs.toLocaleString('en-US')}</span>
        <span class="m-k">DOCUMENTS INGESTED</span>
      </div>
      <div class="metric">
        <span class="m-v num">{sourceFeeds}</span>
        <span class="m-k">SOURCE FEEDS</span>
      </div>
      <div class="metric">
        <span class="m-v num">{String(live.length).padStart(2, '0')}</span>
        <span class="m-k">SIGNALS LIVE</span>
      </div>
      <div class="metric">
        <span class="m-v num">{String(verified).padStart(2, '0')}</span>
        <span class="m-k">VERIFIED</span>
      </div>
      <div class="metric">
        <span class="m-v num">{String(corroborated).padStart(2, '0')}</span>
        <span class="m-k">CORROBORATED 3+</span>
      </div>
    </div>
  </section>

  <div class="shell"><CategoryNav /></div>

  {lead && (
    <section class="lead-wrap">
      <div class="shell lead">
        <div class="lead-rule" aria-hidden="true">
          <div class="lead-fill" style={`height:${lead.confidence_score}%`}></div>
        </div>

        <div class="lead-body">
          <p class="lead-tag num">TOP SIGNAL / {SIGNAL_TYPE_LABELS[lead.type].toUpperCase()}</p>
          <h2 class="lead-title"><a href={`/signal/${lead.id}`}>{lead.title}</a></h2>
          <p class="lead-sum">{lead.summary}</p>
        </div>

        <div class="lead-side">
          <div class="lead-score">
            <span class="ls-v num">{lead.confidence_score}</span>
            <span class="ls-k num">CONFIDENCE</span>
          </div>
          <ul class="lead-srcs">
            {lead.top_sources.map((s) => (
              <li>
                <span class="ls-dom num" data-tier={s.tier}>{s.domain}</span>
                {s.tier === 1 && <span class="ls-pri num">PRIMARY</span>}
              </li>
            ))}
            {lead.source_count > lead.top_sources.length && (
              <li class="ls-rest num">+{lead.source_count - lead.top_sources.length} MORE</li>
            )}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="feed-wrap">
    <div class="shell feed-grid">
      <div class="feed">
        {rest.map((day) => (
          <div class="day">
            <h3 class="day-label num caret">{day.label.toUpperCase()}</h3>
            {day.entries.map((entry) => <SignalRow entry={entry} />)}
          </div>
        ))}

        {live.length > FRONT_PAGE_LIMIT && (
          <p class="more-note">
            Showing the {FRONT_PAGE_LIMIT} most recent of {live.length} live
            signals. Browse by category above for the rest.
          </p>
        )}
      </div>

      <aside class="rail">
        <div class="rail-block">
          <h3 class="rail-head num caret">ACTIVITY BY CATEGORY</h3>
          <ul class="cats">
            {topTypes.map(([t, n]) => (
              <li>
                <span class="cat-n">{SIGNAL_TYPE_LABELS[t as keyof typeof SIGNAL_TYPE_LABELS]}</span>
                {showCatBars && (
                  <span class="cat-bar" aria-hidden="true">
                    <span class="cat-fill" style={`width:${(n / maxType) * 100}%`}></span>
                  </span>
                )}
                <span class="cat-v num">{n}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rail-block">
          <h3 class="rail-head num caret">SCORING</h3>
          <p class="rail-note">
            Confidence is computed from how many independent outlets carried a
            claim and how close they sat to the source. A model's own judgment
            can move it by at most 15 points.
          </p>
          <a class="rail-link num" href="/method">READ THE METHOD</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: var(--rule);
    background: var(--void);
    padding-block: var(--gap-6);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap-6);
    align-items: end;
  }

  .prompt {
    margin: 0 0 var(--gap-4);
    font-size: var(--t-xs);
    letter-spacing: 0.02em;
  }
  .prompt-sig { color: var(--ember); }
  .prompt-c, .prompt-p { color: var(--text-faint); }
  .prompt-h { color: var(--amber); }

  .thesis {
    font-size: clamp(1.5rem, 3vw, var(--t-2xl));
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 var(--gap-3);
    max-width: 22ch;
  }

  .sub {
    margin: 0;
    color: var(--text-dim);
    font-size: var(--t-sm);
    line-height: 1.6;
    max-width: 48ch;
  }

  .spectrum { margin: 0; }

  .spec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--mono);
    font-size: var(--t-2xs);
    letter-spacing: 0.08em;
    margin-bottom: var(--gap-3);
    padding-bottom: var(--gap-2);
    border-bottom: var(--rule);
  }
  .spec-title { color: var(--text-dim); }
  .spec-stat { color: var(--ember); }

  .plot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4px;
    height: 7.5rem;
    padding-bottom: 1px;
    border-bottom: 1px solid var(--line-bright);
  }

  /* Each tick is one signal, height = confidence. Narrow by design: this must
     still read as a distribution at several hundred signals. */
  .tick {
    flex: 1 1 0;
    max-width: 20px;
    min-width: 0;
    height: var(--h);
    background: var(--c);
    opacity: 0.85;
    transition: opacity 0.1s, transform 0.1s;
    transform-origin: bottom;
  }
  .tick:hover, .tick:focus-visible { opacity: 1; transform: scaleX(1.6); }

  .axis {
    display: flex;
    justify-content: space-between;
    margin-top: var(--gap-2);
    font-size: var(--t-2xs);
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }

  .metrics { border-bottom: var(--rule); background: var(--raised); }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--gap-4) var(--gap-4) var(--gap-4) 0;
    border-right: var(--rule);
  }
  .metric:last-child { border-right: 0; }
  .m-v { font-size: clamp(1.05rem, 1.5vw, var(--t-xl)); font-weight: 500; line-height: 1; }
  .m-k {
    font-family: var(--mono);
    font-size: var(--t-2xs);
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .lead-wrap { border-bottom: var(--rule); background: var(--raised-2); }

  .lead {
    display: grid;
    grid-template-columns: 3px minmax(0, 1fr) minmax(0, 14rem);
    gap: var(--gap-4);
    padding-block: var(--gap-5);
    align-items: start;
  }
  .lead-rule { position: relative; background: var(--line); align-self: stretch; min-height: 100%; }
  .lead-fill { position: absolute; bottom: 0; left: 0; right: 0; background: var(--ember); }

  .lead-tag {
    font-size: var(--t-2xs);
    letter-spacing: 0.1em;
    color: var(--ember);
    margin: 0 0 var(--gap-2);
  }

  .lead-title {
    font-size: clamp(1.25rem, 2.2vw, var(--t-xl));
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 var(--gap-3);
    max-width: 34ch;
  }
  .lead-title a { text-decoration: none; transition: color 0.12s; }
  .lead-title a:hover { color: var(--ember); }

  .lead-sum {
    margin: 0;
    color: var(--text-dim);
    font-size: var(--t-sm);
    line-height: 1.6;
    max-width: 68ch;
  }

  .lead-side {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3);
    align-items: flex-end;
    text-align: right;
  }
  .lead-score { display: flex; flex-direction: column; gap: 0.15rem; align-items: flex-end; }
  .ls-v { font-size: var(--t-2xl); font-weight: 500; line-height: 1; color: var(--ember); }
  .ls-k { font-size: var(--t-2xs); letter-spacing: 0.08em; color: var(--text-faint); }

  .lead-srcs {
    list-style: none;
    margin: 0;
    padding: var(--gap-3) 0 0;
    border-top: var(--rule);
    width: 100%;
  }
  .lead-srcs li {
    display: flex;
    justify-content: space-between;
    gap: var(--gap-2);
    padding-block: 0.25rem;
  }
  .ls-dom { font-size: var(--t-2xs); color: var(--text-dim); }
  .ls-dom[data-tier='1'] { color: var(--rust); }
  .ls-pri { font-size: var(--t-2xs); color: var(--ember); letter-spacing: 0.06em; }
  .ls-rest { font-size: var(--t-2xs); color: var(--text-faint); }

  .feed-wrap { padding-top: var(--gap-5); }

  .feed-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: var(--gap-6);
    align-items: start;
  }

  .day { margin-bottom: var(--gap-5); }
  .day-label {
    font-size: var(--t-2xs);
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin: 0 0 var(--gap-2);
    padding-bottom: var(--gap-2);
    border-bottom: 1px solid var(--line-bright);
  }

  .more-note {
    margin: var(--gap-4) 0 0;
    padding-top: var(--gap-4);
    border-top: var(--rule);
    font-size: var(--t-sm);
    color: var(--text-faint);
    max-width: 52ch;
  }

  .rail {
    position: sticky;
    top: 4.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--gap-5);
  }

  .rail-head {
    font-size: var(--t-2xs);
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin: 0 0 var(--gap-3);
    padding-bottom: var(--gap-2);
    border-bottom: var(--rule);
  }

  .cats { list-style: none; margin: 0; padding: 0; }
  .cats li {
    display: grid;
    grid-template-columns: 1fr auto 1.25rem;
    align-items: center;
    gap: var(--gap-2);
    padding-block: 0.35rem;
  }
  .cat-n { font-size: var(--t-2xs); color: var(--text-dim); }
  .cat-bar { height: 2px; background: var(--line); }
  .cat-fill { display: block; height: 100%; background: var(--rust); }
  .cat-v { font-size: var(--t-2xs); color: var(--text-faint); text-align: right; }

  .rail-note {
    margin: 0 0 var(--gap-3);
    font-size: var(--t-2xs);
    line-height: 1.6;
    color: var(--text-faint);
  }
  .rail-link {
    font-size: var(--t-2xs);
    letter-spacing: 0.08em;
    color: var(--rust);
    text-decoration: none;
  }
  .rail-link:hover { color: var(--ember); }

  @media (max-width: 1000px) {
    .feed-grid { grid-template-columns: 1fr; gap: var(--gap-5); }
    .rail { position: static; order: -1; }
  }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--gap-5); }
    .metrics-grid { grid-template-columns: repeat(2, 1fr); }
    .metric { padding-left: 0; }
    .metric:nth-child(2) { border-right: 0; }
    .metric:nth-child(1), .metric:nth-child(2) { border-bottom: var(--rule); }
    .lead { grid-template-columns: 3px minmax(0, 1fr); }
    .lead-side { display: none; }
    .plot { height: 5.5rem; }
  }
</style>
