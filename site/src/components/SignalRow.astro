---
/**
 * A signal row.
 *
 * The left rule is the design's one carried-over idea: its filled length IS
 * the confidence score, so certainty is legible before a word is read.
 * Everything else is tuned for density and scanning.
 */
import {
  bandColor, statusColor, STATUS_LABELS, relativeTime,
  SIGNAL_TYPE_LABELS, type FeedEntry,
} from '../lib/display.ts';

interface Props {
  entry: FeedEntry;
  /** Entity pages already state their subject; don't repeat it on every row. */
  hideEntity?: string;
}

const { entry, hideEntity } = Astro.props;
const shown = entry.entities.filter((e) => e.id !== hideEntity).slice(0, 3);
const extraSources = entry.source_count - entry.top_sources.length;
---

<article class="row">
  <div class="gauge" aria-hidden="true">
    <div
      class="gauge-fill"
      style={`height:${entry.confidence_score}%;background:${bandColor(entry.confidence_band)}`}
    ></div>
  </div>

  <div class="body">
    <div class="head">
      <span class="type">{SIGNAL_TYPE_LABELS[entry.type]}</span>
      <span class="sep" aria-hidden="true">/</span>
      <span class="status" style={`color:${statusColor(entry.status)}`}>
        {STATUS_LABELS[entry.status]}
      </span>
      <time class="when num" datetime={entry.updated_at}>
        {relativeTime(entry.updated_at)}
      </time>
    </div>

    <h2 class="title"><a href={`/signal/${entry.id}`}>{entry.title}</a></h2>

    <p class="summary">{entry.summary}</p>

    <div class="foot">
      <span class="sources">
        {entry.top_sources.map((s) => (
          <span class="domain" data-tier={s.tier}>{s.domain}</span>
        ))}
        {extraSources > 0 && <span class="more num">+{extraSources}</span>}
      </span>

      {shown.length > 0 && (
        <span class="entities">
          {shown.map((e) => (
            <a class="entity" href={`/entity/${e.slug}`}>{e.name}</a>
          ))}
        </span>
      )}
    </div>
  </div>

  <div class="score">
    <span class="score-num num" style={`color:${bandColor(entry.confidence_band)}`}>
      {String(entry.confidence_score).padStart(2, '0')}
    </span>
    <span class="score-sub num">
      {entry.corroboration_count} SRC
    </span>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 3px minmax(0, 1fr) auto;
    gap: var(--gap-4);
    padding: var(--gap-4) var(--gap-3) var(--gap-4) 0;
    border-bottom: var(--rule);
    align-items: start;
    transition: background 0.1s;
  }
  .row:hover { background: var(--raised); }

  /* Confidence rule: length encodes the score. The page's spine. */
  .gauge {
    height: 100%;
    min-height: 4rem;
    background: var(--line);
    position: relative;
    align-self: stretch;
  }
  .gauge-fill { position: absolute; bottom: 0; left: 0; right: 0; }

  .body { min-width: 0; }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: var(--t-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--gap-2);
  }
  .type { color: var(--text-dim); }
  .sep { color: var(--line-bright); }
  .status { font-weight: 500; }
  .when { margin-left: auto; color: var(--text-faint); text-transform: none; }

  .title {
    font-size: var(--t-md);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.005em;
    margin: 0 0 var(--gap-2);
    max-width: 62ch;
  }
  .title a { text-decoration: none; transition: color 0.12s; }
  .title a:hover { color: var(--ember); }

  .summary {
    margin: 0 0 var(--gap-3);
    color: var(--text-dim);
    font-size: var(--t-sm);
    line-height: 1.55;
    max-width: 78ch;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3);
    align-items: baseline;
  }

  .sources { display: flex; gap: 0.65rem; flex-wrap: wrap; }

  .domain {
    font-family: var(--mono);
    font-size: var(--t-2xs);
    color: var(--text-faint);
  }
  /* Primary sources are the strongest evidence; mark them in the accent. */
  .domain[data-tier='1'] { color: var(--rust); }
  .domain[data-tier='4'] { color: var(--red); opacity: 0.8; }

  .more { font-size: var(--t-2xs); color: var(--text-faint); }

  .entities { display: flex; gap: 0.65rem; flex-wrap: wrap; margin-left: auto; }
  .entity {
    font-size: var(--t-2xs);
    color: var(--text-dim);
    text-decoration: none;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--line);
    transition: border-color 0.12s, color 0.12s;
  }
  .entity:hover { color: var(--ember); border-color: var(--rust); }

  .score {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 3.5rem;
    padding-top: 0.05rem;
  }
  .score-num {
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 1;
  }
  .score-sub {
    font-size: var(--t-2xs);
    color: var(--text-faint);
    margin-top: 0.3rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .row { grid-template-columns: 3px minmax(0, 1fr); gap: var(--gap-3); }
    .score {
      grid-column: 2;
      flex-direction: row;
      align-items: baseline;
      gap: 0.5rem;
      min-width: 0;
      margin-top: var(--gap-2);
    }
    .score-num { font-size: var(--t-lg); }
    .summary { max-width: none; }
    .entities { margin-left: 0; }
  }
</style>
